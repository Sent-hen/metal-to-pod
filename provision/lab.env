# Single source of truth for the lab topology.
# Read by the Vagrantfile (Ruby) AND sourced by every provisioning script (bash),
# so keep it to plain KEY=value lines - no expansions, no spaces around '='.

# --- Network plan -------------------------------------------------------------
# Node network: host-only/private network shared by every VM.
NODE_CIDR=192.168.60.0/24
CP_IP=192.168.60.10
# Workers get WORKER_IP_BASE+1 .. WORKER_IP_BASE+WORKER_COUNT (worker1=.11, ...)
WORKER_IP_BASE=192.168.60.10
WORKER_COUNT=2
CI_IP=192.168.60.20
# Pod and Service ranges must not overlap each other or the node network.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# --- VM sizing (MB / vCPU) ------------------------------------------------------
# Sized for a 16 GB laptop (ASUS ROG Zephyrus G16): 9 GB total for VMs, leaving
# ~7 GB for Windows, VMware and a browser. RAM is the constraint, not CPU.
#   cp1 2 GB  - kubeadm's preflight minimum is 1700 MB; etcd + apiserver use ~1.2 GB
#   workers   - app pods request 32Mi each; Calico + kubelet + Prometheus fit in 2 GB
#   ci 3 GB   - Jenkins (heap capped at 768 MB) + registry + Docker builds
# On a 32 GB+ host, raise to CP 4096 / WORKER 3072 / CI 4096 for more headroom.
CP_MEMORY=2048
CP_CPUS=2
WORKER_MEMORY=2048
WORKER_CPUS=2
CI_MEMORY=3072
CI_CPUS=2

# --- Package mirror -------------------------------------------------------------
# Ubuntu archive used by every VM (no trailing slash). The box defaults to
# us.archive.ubuntu.com, which can refuse connections; kernel.org's mirror is a
# reliable global CDN. A nearby university mirror is usually faster, e.g.
#   http://mirror.math.princeton.edu/pub/ubuntu   http://mirrors.mit.edu/ubuntu
UBUNTU_MIRROR=http://mirrors.edge.kernel.org/ubuntu

# --- Versions -----------------------------------------------------------------
# Kubernetes minor release; pkgs.k8s.io has one apt repo per minor.
K8S_MINOR=v1.36
CALICO_VERSION=v3.32.2

# --- Services -------------------------------------------------------------------
REGISTRY_HOST=registry.lab
REGISTRY_PORT=5000
JENKINS_PORT=8080
APP_NAMESPACE=logistics
APP_NODEPORT=30080
PROMETHEUS_NODEPORT=30090
